{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "care-of-your-hair",
	"compatibility_date": "2026-09-18",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"routes": [
		{
			"pattern": "krasovska.beauty/*",
			"zone_name": "krasovska.beauty"
		}
	],
	"main": "vinext/server/fetch-handler",
	"observability": {
		"enabled": false,
		"head_sampling_rate": 1,
		"redact_query_string": false,
		"logs": {
			"enabled": true,
			"head_sampling_rate": 1,
			"invocation_logs": true,
			"persist": true
		},
		"traces": {
			"enabled": false,
			"head_sampling_rate": 1,
			"persist": true
		},
		"issues": {
			"enabled": true
		}
	},
	"assets": {
		"directory": "dist/client",
		"not_found_handling": "none",
		"binding": "ASSETS"
	},
	"images": {
		"binding": "IMAGES"
	},
	"kv_namespaces": [
		{
			"binding": "BOOKING_CACHE",
			"id": "b6b1955f908a44f7bcaeab12594819dd"
		}
	]
}